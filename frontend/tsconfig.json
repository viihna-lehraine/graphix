{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "isolatedModules": true,
    "lib": ["DOM", "ES2022"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "outDir": "./public/dist",
    "paths": {
      "@bootstrap/*": ["src/app/sys/bootstrap/*"],
      "@build/*": ["src/app/build/*"],
      "@config/*": ["src/app/config/*"],
      "@data/*": ["src/app/data/*"],
      "@engine/*": ["src/app/engine/*"],
      "@meta/*": ["src/app/meta/*"],
      "@services/*": ["src/app/services/*"],
      "@sys/*": ["src/app/sys/*"],
      "@sys_init/*": ["src/app/sys/init/*"],
      "@sys_launch/*": ["src/app/sys/launch/*"],
      "@sys_registries/*": ["src/app/sys/registries/*"],
      "@types/*": ["src/app/types/*"]
    },
    "resolveJsonModule": true,
    "rootDir": "./src",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "useDefineForClassFields": true,
    "useUnknownInCatchVariables": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/build", "node_modules", "public/js", "dist"]
}
