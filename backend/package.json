{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "pnpm run strip_comments && pnpm build:knex && pnpm build:src",
    "build:knex": "tsc -p tsconfig.knex.json",
    "build:src": "tsc -p tsconfig.json",
    "clean": "rm -rf node_modules dist",
    "dev": "nodemon",
    "migrate": "pnpm build:knex && knex migrate:latest --knexfile knex-dist/knexfile.js",
    "reinit": "pnpm run clean && pnpm install",
    "start": "node dist/server.js",
    "strip_comments": "tsx scripts/strip_file_comments.ts",
    "test": "vitest run",
    "test:full": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "author": "Viihna Lehraine",
  "license": "GNU GPLv3",
  "packageManager": "pnpm@10.6.5",
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/sensible": "^6.0.3",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "fastify-plugin": "^5.0.1",
    "knex": "^3.1.0",
    "nanoid": "^5.1.5",
    "slugify": "^1.6.6",
    "sqlite3": "^5.1.7",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^24.0.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "sqlite3"
    ],
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
