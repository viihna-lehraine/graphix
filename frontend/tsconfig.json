{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "isolatedModules": true,
    "lib": ["DOM", "ES2022"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "outDir": "./public/dist",
    "paths": {
      "@AnimationGroupManager/*": [
        "src/app/features/engine/AnimationGroupManager.js"
      ],
      "@bootstrap/*": ["src/app/sys/bootstrap/*"],
      "@build/*": ["src/app/build/*"],
      "@core/*": ["src/app/core/*"],
      "@data/*": ["src/app/data/*"],
      "@engine/*": ["src/app/features/engine/*"],
      "@event_registry/*": ["src/app/sys/registries/events.js"],
      "@features/*": ["src/app/features/*"],
      "@init/*": ["src/app/sys/init/*"],
      "@sys/*": ["src/app/sys/*"],
      "@sys_registries/*": ["src/app/sys/registries/*"],
      "@types/*": ["src/app/types/*"]
    },
    "resolveJsonModule": true,
    "rootDir": "./src",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "useDefineForClassFields": true,
    "useUnknownInCatchVariables": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/build", "node_modules", "public/js", "dist"]
}
